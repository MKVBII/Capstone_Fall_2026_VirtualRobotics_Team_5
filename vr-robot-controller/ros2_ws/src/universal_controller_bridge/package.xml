<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>universal_controller_bridge</name>
  <version>0.0.1</version>
  <description>
    rosbridge launch config plus the safety/watchdog node that halts robot
    motion if the WebSocket link to the VR client drops.
  </description>
  <maintainer email="burchamw@merrimack.edu">Wesley Burcham</maintainer>
  <license>TODO</license>

  <depend>rclpy</depend>
  <depend>rosbridge_server</depend>
  <depend>geometry_msgs</depend>
  <depend>universal_controller_interface</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
