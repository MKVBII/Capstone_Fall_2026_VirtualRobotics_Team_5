<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>adapter_base</name>
  <version>0.0.1</version>
  <description>
    Abstract adapter interface every robot adapter (e.g. adapter_osoyoo_car)
    implements. Not runnable on its own — a library package.
  </description>
  <maintainer email="burchamw@merrimack.edu">Wesley Burcham</maintainer>
  <license>TODO</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>universal_controller_interface</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
