<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>controller_bringup</name>
  <version>0.0.1</version>
  <description>
    Single launch file that brings up the entire Pi-side stack: rosbridge,
    the safety watchdog, the active robot adapter, and video streaming.
  </description>
  <maintainer email="burchamw@merrimack.edu">Wesley Burcham</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>universal_controller_bridge</exec_depend>
  <exec_depend>adapter_osoyoo_car</exec_depend>
  <exec_depend>video_streaming</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
