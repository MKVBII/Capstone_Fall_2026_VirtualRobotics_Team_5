# Files git should never track.

# Python's compiled caches - recreated automatically, differ per machine.
__pycache__/
*.pyc

# Security certificates/keys (needed later for the headset's https page).
# Secret keys must never be committed to GitHub.
*.pem
*.key
*.crt

# Operating system / editor clutter.
.DS_Store
Thumbs.db
.vscode/
*.swp

# Made on the Pi while it runs: session logs (download them from the start
# screen) and the saved website/headset settings.
robot-car/logs/
robot-car/settings.json
