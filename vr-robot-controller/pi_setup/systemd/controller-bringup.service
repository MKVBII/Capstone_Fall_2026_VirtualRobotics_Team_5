# Runs `ros2 launch controller_bringup bringup.launch.py` on boot.
#
# Install: sudo cp controller-bringup.service /etc/systemd/system/
#          sudo systemctl enable --now controller-bringup.service
#
# TODO: fill in the real workspace path once it's deployed on the Pi.
[Unit]
Description=VR Universal Robot Controller - Pi bringup (OSOYOO car)
After=network.target

[Service]
Type=simple
# TODO: replace with the real path, e.g. /home/pi/vr-robot-controller/ros2_ws
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source /path/to/ros2_ws/install/setup.bash && ros2 launch controller_bringup bringup.launch.py'
Restart=on-failure
User=pi

[Install]
WantedBy=multi-user.target
