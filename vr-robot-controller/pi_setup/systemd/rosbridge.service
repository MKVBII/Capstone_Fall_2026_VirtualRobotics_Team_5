# Optional: standalone rosbridge service, only needed if you want rosbridge
# running independently of controller-bringup.service (which already
# includes it via universal_controller_bridge/launch/rosbridge.launch.py).
#
# Not enabled by default — controller-bringup.service is the one meant to
# run in normal operation.
[Unit]
Description=rosbridge_server (standalone, optional)
After=network.target

[Service]
Type=simple
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && ros2 launch rosbridge_server rosbridge_websocket_launch.xml'
Restart=on-failure
User=pi

[Install]
WantedBy=multi-user.target
